<Page x:Class="WpfApp.Pages.OrderEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Заказ"
      FontFamily="Calibri"
      Background="#FFFFFF">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid MaxWidth="900"
              Margin="40"
              HorizontalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->

            <TextBlock Grid.Row="0"
                       Text="{Binding PageTitle, Mode=OneWay}"
                       FontSize="30"
                       FontWeight="Bold"
                       Margin="0,0,0,25"/>

            <!-- Ошибки -->

            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding ErrorMessages}"
                          Margin="0,0,0,15">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="Red"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,3"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <!-- Клиент -->

            <StackPanel Grid.Row="2"
                        Margin="0,0,0,20">

                <TextBlock Text="Клиент"
                           FontSize="15"
                           Margin="0,0,0,5"/>

                <ComboBox ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          Height="40"
                          FontSize="15">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Surname, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Patronymic, Mode=OneWay}"/>
                                <Run Text=" – "/>
                                <Run Text="{Binding Login, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

            </StackPanel>

            <!-- Товары -->

            <Border Grid.Row="3"
                    Padding="20"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Background="#F8F8F8"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Товары заказа"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                  Height="40"
                                  FontSize="15"
                                  Margin="0,0,10,0">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding SKU, Mode=OneWay}"
                                             FontWeight="Bold"/>
                                        <Run Text=" – "/>
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>

                        <TextBox Grid.Column="1"
                                 Text="{Binding NewQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,10,0"/>

                        <Button Grid.Column="2"
                                Content="Добавить"
                                Height="40"
                                Background="#B8860B"
                                Foreground="White"
                                FontSize="14"
                                Command="{Binding AddProductCommand}"/>

                    </Grid>

                    <ItemsControl ItemsSource="{Binding OrderProducts}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border BorderBrush="LightGray"
                                        BorderThickness="1"
                                        Background="White"
                                        Padding="10"
                                        Margin="0,0,0,8">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding DataContext.Products,
                                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                                  SelectedItem="{Binding Product, Mode=TwoWay}"
                                                  Height="35"
                                                  FontSize="14">

                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding SKU, Mode=OneWay}"
                                                             FontWeight="Bold"/>
                                                        <Run Text=" – "/>
                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>

                                        </ComboBox>

                                        <Button Grid.Column="1"
                                                Content="−"
                                                Width="35"
                                                Height="35"
                                                Margin="10,0,5,0"
                                                Command="{Binding DecreaseQuantityCommand}"/>

                                        <TextBox Grid.Column="2"
                                                 Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="35"
                                                 FontSize="15"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"/>

                                        <Button Grid.Column="3"
                                                Content="+"
                                                Width="35"
                                                Height="35"
                                                Margin="5,0,10,0"
                                                Command="{Binding IncreaseQuantityCommand}"/>

                                        <Button Grid.Column="4"
                                                Content="Удалить"
                                                Height="35"
                                                Background="#B8860B"
                                                Foreground="White"
                                                Command="{Binding RemoveCommand}"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>

            <!-- Статус и пункт выдачи -->

            <Grid Grid.Row="4"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Статус заказа"
                               FontSize="15"
                               Margin="0,0,0,5"/>

                    <ComboBox ItemsSource="{Binding OrderStatuses}"
                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Height="40"
                              FontSize="15"/>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="Пункт выдачи"
                               FontSize="15"
                               Margin="0,0,0,5"/>

                    <ComboBox ItemsSource="{Binding PickupPoints}"
                              SelectedItem="{Binding SelectedPickupPoint, Mode=TwoWay}"
                              Height="40"
                              FontSize="14">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding PostalIndex, Mode=OneWay}"/>
                                    <Run Text=", "/>
                                    <Run Text="{Binding City, Mode=OneWay}"/>
                                    <Run Text=", "/>
                                    <Run Text="{Binding Street, Mode=OneWay}"/>
                                    <Run Text=", "/>
                                    <Run Text="{Binding BuildingNumber, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>

                </StackPanel>

            </Grid>

            <!-- Даты -->

            <Grid Grid.Row="5"
                  Margin="0,0,0,30">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Дата заказа"
                               FontSize="15"
                               Margin="0,0,0,5"/>

                    <DatePicker SelectedDate="{Binding OrderDate, Mode=TwoWay}"
                                Height="40"
                                FontSize="15"/>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="Дата выдачи"
                               FontSize="15"
                               Margin="0,0,0,5"/>

                    <DatePicker SelectedDate="{Binding DeliveryDate, Mode=TwoWay}"
                                Height="40"
                                FontSize="15"/>

                </StackPanel>

            </Grid>

            <!-- Кнопки -->

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Отмена"
                        Width="130"
                        Height="42"
                        Margin="0,0,10,0"
                        FontSize="15"
                        Command="{Binding BackCommand}"/>

                <Button Content="Сохранить"
                        Width="150"
                        Height="42"
                        Background="#B8860B"
                        Foreground="White"
                        FontSize="15"
                        Command="{Binding SaveCommand}"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>
</Page>