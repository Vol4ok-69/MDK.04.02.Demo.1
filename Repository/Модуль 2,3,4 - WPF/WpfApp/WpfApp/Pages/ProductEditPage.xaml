<Page x:Class="WpfApp.Pages.ProductEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Товар"
      FontFamily="Calibri"
      Background="#FFFFFF">
     <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding PageTitle, Mode=OneWay}"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <ItemsControl Grid.Row="1"
              ItemsSource="{Binding ErrorMessages}"
              Margin="0,0,0,15">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                       Foreground="Red"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,0,3"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <Border Width="200"
                            Height="140"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            Background="White">

                        <Image Source="{Binding ImageSource, Mode=OneWay}"
                               Stretch="Uniform"/>
                    </Border>

                    <Button Content="Выбрать изображение"
                            Width="200"
                            Height="40"
                            Margin="0,10,0,0"
                            Background="#B8860B"
                            Foreground="White"
                            Command="{Binding SelectImageCommand}"/>

                </StackPanel>

                <Grid Grid.Column="1"
                      Margin="25,0,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="ID"
                               FontSize="15"
                               Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBox Grid.Row="1"
                             Text="{Binding ProductId, Mode=OneWay}"
                             IsReadOnly="True"
                             Height="35"
                             FontSize="15"
                             Margin="0,3,0,10"
                             Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Grid.Row="2"
                               Text="Артикул"
                               FontSize="15"/>

                    <TextBox Grid.Row="3"
                             Text="{Binding SKU, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             FontSize="15"
                             Margin="0,3,0,10"/>

                    <TextBlock Grid.Row="4"
                               Text="Наименование"
                               FontSize="15"/>

                    <TextBox Grid.Row="5"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             FontSize="15"
                             Margin="0,3,0,10"/>

                    <TextBlock Grid.Row="6"
                               Text="Категория"
                               FontSize="15"/>

                    <ComboBox Grid.Row="7"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              Height="35"
                              FontSize="15"
                              Margin="0,3,0,10"/>

                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">

                            <TextBlock Text="Производитель"
                                       FontSize="15"/>

                            <ComboBox ItemsSource="{Binding Manufacturers}"
                                      SelectedItem="{Binding SelectedManufacturer}"
                                      DisplayMemberPath="Name"
                                      Height="35"
                                      FontSize="15"
                                      Margin="0,3,0,10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">

                            <TextBlock Text="Поставщик"
                                       FontSize="15"/>

                            <ComboBox ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding SelectedSupplier}"
                                      DisplayMemberPath="Name"
                                      Height="35"
                                      FontSize="15"
                                      Margin="0,3,0,10"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="9">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,10,10">

                            <TextBlock Text="Цена"
                                       FontSize="15"/>

                            <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="35"
                                     FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,10,10">

                            <TextBlock Text="Единица измерения"
                                       FontSize="15"/>

                            <ComboBox ItemsSource="{Binding Units}"
                                      SelectedItem="{Binding SelectedUnit}"
                                      DisplayMemberPath="Name"
                                      Height="35"
                                      FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="10,0,0,10">

                            <TextBlock Text="Количество на складе"
                                       FontSize="15"/>

                            <TextBox Text="{Binding StockQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="35"
                                     FontSize="15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,10,10">

                            <TextBlock Text="Скидка"
                                       FontSize="15"/>

                            <TextBox Text="{Binding CurrentDiscountText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="35"
                                     FontSize="15"/>
                        </StackPanel>
    
                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3">

                            <TextBlock Text="Описание"
                                       FontSize="15"/>

                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     Height="100"
                                     FontSize="15"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     Margin="0,3,0,15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Content="Назад"
                                    Width="120"
                                    Height="40"
                                    Margin="0,0,10,0"
                                    Command="{Binding CancelCommand}"/>

                            <Button Content="Сохранить"
                                    Width="140"
                                    Height="40"
                                    Background="#B8860B"
                                    Foreground="White"
                                    Command="{Binding SaveCommand}"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Grid>
        </Grid>
    </ScrollViewer>
</Page>