<Page x:Class="WpfApp.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Товары"
      FontFamily="Calibri"
      Background="#FFFFFF">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#DAA520"
                Padding="15">

            <Grid>
                <TextBlock Text="Список товаров"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding FullName, Mode=OneWay}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="{Binding RoleName, Mode=OneWay}"
                                   FontSize="14"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>

                    <Button Content="Добавить товар"
                            Width="140"
                            Height="35"
                            Margin="0,0,10,0"
                            FontSize="14"
                            Background="#B8860B"
                            Foreground="White"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding AddProductCommand}"/>
                    <Button Content="Заказы"
                            Width="100"
                            Height="35"
                            Margin="0,0,10,0"
                            FontSize="14"
                            Background="#B8860B"
                            Foreground="White"
                            Visibility="{Binding IsManagerOrAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding OrdersCommand}"/>
                    <Button Content="Выйти"
                            Width="100"
                            Height="35"
                            FontSize="15"
                            Background="#B8860B"
                            Foreground="White"
                            Command="{Binding LogoutCommand, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
        Margin="20,20,20,0"
        Padding="15"
        Background="#F5F5F5"
        BorderBrush="LightGray"
        BorderThickness="1"
        Visibility="{Binding IsManagerOrAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                 Height="35"
                 Margin="0,0,10,0"
                 VerticalContentAlignment="Center"
                 FontSize="15"
                 ToolTip="Поиск по товарам"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Column="1"
                  Height="35"
                  Margin="0,0,10,0"
                  VerticalContentAlignment="Center"
                  FontSize="15"
                  ItemsSource="{Binding Manufacturers}"
                  SelectedItem="{Binding SelectedManufacturer}"
                  DisplayMemberPath="Name"/>

                <ComboBox Grid.Column="2"
                  Height="35"
                  Margin="0,0,10,0"
                  VerticalContentAlignment="Center"
                  FontSize="15"
                  ItemsSource="{Binding SortOptions}"
                  SelectedItem="{Binding SelectedSort}"/>

                <Button Grid.Column="3"
                Height="35"
                Margin="0,0,10,0"
                Background="#B8860B"
                Foreground="White"
                FontSize="14"
                Content="{Binding SortDirectionText}"
                Command="{Binding ToggleSortDirectionCommand}"/>

                <Button Grid.Column="4"
                Height="35"
                Background="#DAA520"
                FontSize="14"
                Content="Сбросить"
                Command="{Binding ResetFiltersCommand}"/>
            </Grid>
        </Border>

        <ListBox Grid.Row="2"
         ItemsSource="{Binding Products, Mode=OneWay}"
         Margin="20"
         BorderThickness="0"
         Background="White"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

                    <Setter Property="Padding"
                    Value="0"/>

                    <Setter Property="Margin"
                    Value="0,0,0,10"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Border Background="{Binding RowBackground, Mode=OneWay}"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="12">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                            Width="140"
                            Height="110"
                            HorizontalAlignment="Left"
                            Background="White"
                            BorderBrush="LightGray"
                            BorderThickness="1">

                                <Image Source="{Binding ImageSource, Mode=OneWay}"
                               Stretch="Uniform"/>
                            </Border>

                            <Grid Grid.Column="1"
                                    Margin="15,0,0,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding Name, Mode=OneWay}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>

                                <TextBlock Grid.Row="1"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5">
                                    <Run Text="Артикул: "/>
                                    <Run Text="{Binding SKU, Mode=OneWay}"/>        
                                </TextBlock>

                                <TextBlock Grid.Row="2"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5">
                                    <Run Text="Категория: "/>
                                    <Run Text="{Binding CategoryName, Mode=OneWay}"/>   
                                </TextBlock>

                                <TextBlock Grid.Row="3"
                                            FontSize="14"
                                           TextWrapping="Wrap"
                                           MaxHeight="60"
                                           Margin="0,0,0,5">
                                    <Run Text="Описание: "/>
                                    <Run Text="{Binding Description, Mode=OneWay}"/>
                                </TextBlock>

                                <Grid Grid.Row="4"
                                      Margin="0,0,0,5">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               FontSize="14"
                                               TextWrapping="Wrap">
                                        <Run Text="Производитель: "/>
                                        <Run Text="{Binding ManufacturerName, Mode=OneWay}"/>   
                                    </TextBlock>

                                    <TextBlock Grid.Column="1"
                                               FontSize="14"
                                               TextWrapping="Wrap">
                                        <Run Text="Поставщик: "/>
                                        <Run Text="{Binding SupplierName, Mode=OneWay}"/>
                                    </TextBlock>

                                </Grid>

                                <StackPanel Grid.Row="5"
                                            Orientation="Horizontal">

                                    <TextBlock FontSize="16"
                                               Margin="0,0,20,0"
                                               Visibility="{Binding RegularPriceVisibility, Mode=OneWay}">
                                        <Run Text="Цена: "/>
                                        <Run Text="{Binding Price, Mode=OneWay, StringFormat={}{0:F2} руб.}"/>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding DiscountedPriceVisibility, Mode=OneWay}">

                                        <TextBlock FontSize="16"
                                                   Foreground="Red"
                                                   TextDecorations="Strikethrough"
                                                   Margin="0,0,8,0">
                                            <Run Text="{Binding Price, Mode=OneWay, StringFormat={}{0:F2} руб.}"/>
                                        </TextBlock>

                                        <TextBlock FontSize="16"
                                                   Foreground="Black"
                                                   Margin="0,0,20,0">
                                            <Run Text="{Binding FinalPrice, Mode=OneWay, StringFormat={}{0:F2} руб.}"/>
                                        </TextBlock>

                                    </StackPanel>

                                    <TextBlock FontSize="16"
                                               Margin="0,0,20,0">
                                        <Run Text="Ед. изм.: "/>
                                        <Run Text="{Binding UnitName, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock FontSize="16"
                                               Margin="0,0,20,0">
                                        <Run Text="На складе: "/>
                                        <Run Text="{Binding StockQuantity, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock FontSize="16">
                                        <Run Text="Скидка: "/>
                                        <Run Text="{Binding CurrentDiscount, Mode=OneWay, StringFormat={}{0:F0}%}"/>
                                    </TextBlock>

                                </StackPanel>

                                <StackPanel Grid.Row="6"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,5,0,0">

                                    <Button Content="Редактировать"
                                            Width="130"
                                            Height="35"
                                            Background="#B8860B"
                                            Foreground="White"
                                            Visibility="{Binding DataContext.IsAdmin,RelativeSource={RelativeSource AncestorType=ListBox},Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Command="{Binding DataContext.EditProductCommand,RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>

                                    <Button Content="Удалить"
                                            Width="100"
                                            Height="35"
                                            Margin="10,0,0,0"
                                            Background="#B8860B"
                                            Foreground="White"
                                            Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>

                                </StackPanel>

                            </Grid>
                        </Grid>
                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>