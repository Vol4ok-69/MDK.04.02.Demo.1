<Page x:Class="WpfApp.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:WpfApp.Helpers"
      Title="Авторизация"
      FontFamily="Calibri"
      Background="#FFFFFF">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#DAA520">
            <Image Source="/Resources/icon.png"
                   Height="75"
                   Margin="20"
                   HorizontalAlignment="Left"
                   Stretch="Uniform"/>
        </Border>

        <Border Grid.Row="1"
                Width="420"
                Padding="30"
                Background="#DAA520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Авторизация"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Логин"
                           FontSize="16"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         Height="35"
                         FontSize="16"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Пароль"
                   FontSize="16"
                   Margin="0,0,0,5"/>

                <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                             helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}"
                             Height="35"
                             FontSize="16"
                             Margin="0,0,0,10"/>

                <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                           Foreground="#8B0000"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                

                <Button Content="Войти"
                    Height="40"
                    FontSize="16"
                    Background="#B8860B"
                    Foreground="White"
                    Command="{Binding LoginCommand}"
                    Margin="0,0,0,10"/>

                <Button Content="Войти как гость"
                    Height="40"
                    FontSize="16"
                    Command="{Binding GuestCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>